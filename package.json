{
  "name": "rea4u",
  "private": true,
  "version": "0.1.0",
  "description": "rea4u: reverse engineer anything. Paste a repo or site, get a rebranded working clone, a spec, ranked hosting and a token on pump.fun, Jupiter, Bonk.fun, Pons or StonkLauncher.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "catalog": "node scripts/build-catalog.mjs",
    "dev": "npm run catalog && vite",
    "build": "npm run catalog && tsc --noEmit && tsc -p worker/tsconfig.json && vite build",
    "worker:dev": "wrangler dev",
    "worker:check": "tsc -p worker/tsconfig.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:sim": "NODE_USE_ENV_PROXY=1 vitest run -c vitest.live.config.ts",
    "test:e2e": "NODE_USE_ENV_PROXY=1 playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@fontsource/bangers": "5.3.0",
    "@fontsource/comic-neue": "5.3.0",
    "@fontsource/vt323": "5.3.0",
    "@noble/curves": "2.4.0",
    "@pump-fun/pump-sdk": "4.1.0",
    "@solana/spl-token": "0.4.15",
    "@solana/wallet-standard-features": "1.5.0",
    "@solana/web3.js": "1.99.0",
    "@wallet-standard/app": "1.1.1",
    "@wallet-standard/base": "1.1.1",
    "bn.js": "5.2.5",
    "bs58": "6.0.0",
    "buffer": "6.0.3",
    "viem": "2.57.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260930.2",
    "@playwright/test": "^1.64.1",
    "@types/bn.js": "^5.2.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "4.145.0"
  }
}
