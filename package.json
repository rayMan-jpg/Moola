{
  "name": "aerlock",
  "version": "0.1.0",
  "private": true,
  "description": "AERLOCK — High-Altitude Security landing page + telemetry console",
  "scripts": {
    "build": "tailwindcss -i src/input.css -o dist/aerlock.css --minify",
    "watch": "tailwindcss -i src/input.css -o dist/aerlock.css --watch",
    "serve": "python3 -m http.server 8080",
    "dev": "npm run build && npm run serve"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "playwright": "^1.61.1",
    "tailwindcss": "^3.4.19"
  }
}
